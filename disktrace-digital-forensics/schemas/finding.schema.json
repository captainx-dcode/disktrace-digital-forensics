{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiskTrace Finding",
  "type": "object",
  "required": [
    "finding_id",
    "case_id",
    "title",
    "statement",
    "classification",
    "evidence_refs",
    "limitations",
    "review_status"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "classification": {
      "type": "string",
      "enum": [
        "confirmed_observation",
        "interpretation",
        "unresolved_hypothesis"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "method": {
      "type": [
        "string",
        "null"
      ]
    },
    "significance": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "draft",
        "under_review",
        "approved",
        "rejected"
      ]
    }
  },
  "additionalProperties": false
}
